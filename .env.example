# API process
API_HOST=127.0.0.1
API_PORT=8000

# Repository-relative paths are resolved from the project root.
MODEL_DIR=models/reproducible/final
PREMATCH_FEATURES_PATH=outputs/features/prematch_features.parquet
SNAPSHOT_FEATURES_PATH=outputs/snapshots/snapshot_features.parquet
FEATURE_MANIFEST_PATH=outputs/features/feature_manifest.json
SNAPSHOT_MANIFEST_PATH=outputs/snapshots/snapshot_manifest.json

# Comma-separated browser origins. Origins never contain a path.
ALLOWED_ORIGINS=https://mana-peiravian.github.io,http://localhost:8000,http://127.0.0.1:8000

# Used in generated OpenAPI server metadata. Replace only after deploying FastAPI.
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
